# Local/test-only commerce configuration. Never commit real secrets.
APP_BASE_URL=http://localhost:5173
APP_ENV=development
# Local convenience only. APP_ENV=production always forces MFA regardless of this value.
ADMIN_MFA_REQUIRED=false
DATA_ENCRYPTION_KEY=
SESSION_SECRET=
CAPTCHA_SECRET=

# Stripe sandbox keys for the two legal sellers.
STRIPE_PL_SECRET_KEY=sk_test_replace_me
STRIPE_PL_WEBHOOK_SECRET=whsec_replace_me
STRIPE_INTERNATIONAL_SECRET_KEY=sk_test_replace_me
STRIPE_INTERNATIONAL_WEBHOOK_SECRET=whsec_replace_me

# Existing SMTP transport, also used by idempotent contract notifications.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=hello@timzy.app
NEW_CONTRACT_NOTIFICATION_EMAIL=hello@timzy.app

# Optional downstream Timzy provisioning endpoint. It is never called before payment.
PROVISIONING_WEBHOOK_URL=
PROVISIONING_WEBHOOK_SECRET=
